{
  "name": "node-api-logs",
  "version": "3.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && npm run build:ui",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "prepublishOnly": "npm run build",
    "build:ui": "tsc -p tsconfig.ui.json && node scripts/build-ui.mjs",
    "dev:ui": "node scripts/build-ui.mjs --watch"
  },
  "keywords": [
    "logging",
    "api",
    "express",
    "fastify",
    "nestjs",
    "dashboard",
    "monitoring",
    "bull",
    "bullmq",
    "agenda",
    "pg-boss",
    "alerts",
    "2fa"
  ],
  "author": "",
  "license": "MIT",
  "description": "Request logging, job tracking, alerts and a secure dashboard for Node.js APIs (Express, Fastify, NestJS)",
  "homepage": "https://github.com/ugochukwudev/Node-API-LOGS",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@agendajs/mongo-backend": "^4.0.5",
    "@jest/globals": "^30.2.0",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/platform-fastify": "^12.5.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^22.5.1",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "agenda": "^6.2.8",
    "bull": "^4.16.5",
    "bullmq": "^6.7.7",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.8",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.4.1",
    "nodemailer": "^10.6.0",
    "pg-boss": "^12.38.2",
    "preact": "^11.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "uplot": "^1.6.32"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "default": "./dist/adapters/express.js"
    },
    "./fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "default": "./dist/adapters/fastify.js"
    },
    "./nestjs": {
      "types": "./dist/adapters/nestjs.d.ts",
      "default": "./dist/adapters/nestjs.js"
    },
    "./jobs": {
      "types": "./dist/jobs/index.d.ts",
      "default": "./dist/jobs/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "node-api-logs": "dist/cli.js"
  },
  "peerDependencies": {
    "nodemailer": ">=6"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugochukwudev/Node-API-LOGS.git"
  }
}
