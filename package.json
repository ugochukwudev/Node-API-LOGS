{
  "name": "node-api-logs",
  "version": "3.0.0-alpha.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build:css": "tailwindcss -i src/views/styles/input.css -o src/views/styles/tailwind.css --minify",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:performance": "node test-performance.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": " A package to see logs on your nodejs server (expressjs)",
  "homepage": "https://github.com/ugochukwudev/Node-API-LOGS",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@agendajs/mongo-backend": "^4.0.5",
    "@jest/globals": "^30.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^22.5.1",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "agenda": "^6.2.8",
    "autoprefixer": "^10.6.2",
    "bull": "^4.16.5",
    "bullmq": "^6.7.7",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.4.1",
    "nodemailer": "^10.6.0",
    "nodemon": "^3.1.14",
    "pg-boss": "^12.38.2",
    "postcss": "^8.5.33",
    "postcss-cli": "^11.0.1",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src/views"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "default": "./dist/adapters/express.js"
    },
    "./package.json": "./package.json",
    "./jobs": {
      "types": "./dist/jobs/index.d.ts",
      "default": "./dist/jobs/index.js"
    }
  },
  "bin": {
    "node-api-logs": "dist/cli.js"
  },
  "peerDependencies": {
    "nodemailer": ">=6"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    }
  }
}
